{
  "name": "maven-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Maven — dijital baskı makineleri ve mürekkepleri kurumsal web sitesi",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "images": "node tools/build-images.mjs",
    "fonts": "bash tools/fonts.sh",
    "brand": "tools/.venv/Scripts/python.exe tools/build_brand.py",
    "build": "node tools/build-images.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.5",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.2.1",
    "playwright": "^1.62.0"
  }
}
