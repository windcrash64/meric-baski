---
import InkIndex from '../../../layouts/InkIndex.astro';
import { INK_FAMILY_ROUTE, ROUTES } from '../../../i18n/routes';

export function getStaticPaths() {
  return Object.entries(INK_FAMILY_ROUTE).map(([family, routeKey]) => ({
    params: { aile: ROUTES[routeKey].tr },
    props: { family },
  }));
}

const { family } = Astro.props;
---

<InkIndex locale="tr" family={family} />
