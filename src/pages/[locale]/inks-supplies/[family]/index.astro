---
import InkIndex from '../../../../layouts/InkIndex.astro';
import { INK_FAMILY_ROUTE, NON_DEFAULT_LOCALES, ROUTES } from '../../../../i18n/routes';
import type { Locale } from '../../../../config/site';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.flatMap((locale) =>
    Object.entries(INK_FAMILY_ROUTE).map(([family, routeKey]) => ({
      params: { locale, family: ROUTES[routeKey][locale] },
      props: { family, locale },
    })),
  );
}

const { family, locale } = Astro.props as { family: string; locale: Locale };
---

<InkIndex locale={locale} family={family} />
