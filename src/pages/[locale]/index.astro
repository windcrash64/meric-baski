---
/**
 * Non-default locales, one page module rendering the same layout as the root.
 *
 * `[locale]` is safe sitting next to literal segments like `makineler/` because
 * a static build only ever emits the paths getStaticPaths returns — `/makineler/`
 * can never be swallowed by this route.
 */
import HomePage from '../../layouts/HomePage.astro';
import { NON_DEFAULT_LOCALES } from '../../i18n/routes';
import type { Locale } from '../../config/site';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<HomePage locale={locale} />
