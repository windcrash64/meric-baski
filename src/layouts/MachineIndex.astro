---
/**
 * Machines index and machine-family category page — one template, one prop.
 *
 * The category page is the money page, not the homepage: it carries the real
 * editorial copy, the "what drives the price" section that serves the
 * unavoidable Turkish "fiyat/fiyatları" modifier, and the FAQ that earns the
 * rich result. A bare product grid under an <h1> reading "Ürünler" — which is
 * what the reference site ships — is the failure this template exists to avoid.
 */
import { getCollection, type CollectionEntry } from 'astro:content';

import { SITE, type Locale } from '../config/site';
import { path, type RouteKey } from '../i18n/routes';
import { range, t } from '../i18n/ui';
import { HEAD_BRANDS, SPECS, type SpecKey } from '../i18n/specs';
import { machineFamilyName, machineFamilyRoute, machineHref } from '../lib/product';
import { renderFor } from '../lib/media';
import Base from './Base.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Picture from '../components/media/Picture.astro';
import RailHead from '../components/ui/RailHead.astro';

export interface Props {
  locale: Locale;
  /** Omit for the "all machines" index. */
  family?: string;
}

const { locale, family } = Astro.props;
const tr = locale === 'tr';

const all = (await getCollection('machines'))
  .filter((m) => m.data.status !== 'discontinued')
  .sort((a, b) => a.data.order - b.data.order);

const machines = family ? all.filter((m) => m.data.family === family) : all;
const routeKey: RouteKey = family ? machineFamilyRoute(family) : 'machines';
const heading = family ? machineFamilyName(family, locale) : t('navMachines', locale);

// The index lists products UNDER their category rather than in one flat grid:
// a buyer arrives knowing the process he needs (flatbed, rulodan ruloya, DTF),
// not the model, so the category is the entry point and the grid sits inside it.
const FAMILY_SEQUENCE = [
  'uv-flatbed', 'uv-hybrid', 'eco-solvent', 'dtf',
  'sublimation', 'uv-dtf', 'cutting',
] as const;

const groups = family
  ? [{ key: family, machines }]
  : FAMILY_SEQUENCE
      .map((key) => ({ key, machines: all.filter((m) => m.data.family === key) }))
      .filter((g) => g.machines.length > 0);

/** One factual line per family — what the process is, not why to buy it. */
const FAMILY_ROLE: Record<string, Record<Locale, string>> = {
  'uv-flatbed': {
    tr: 'Sabit tablada rijit malzemeye doğrudan UV baskı. Cam, ahşap, kompozit, levha.',
    en: 'Direct UV printing onto rigid material on a fixed bed: glass, wood, composite, sheet.',
  },
  'uv-hybrid': {
    tr: 'Tek şasede hem rulo hem levha. Rijit tarafta baskı yüksekliği 10–50 mm ile sınırlıdır.',
    en: 'Roll and rigid on one chassis. Print height on the rigid side is limited to 10–50 mm.',
  },
  'eco-solvent': {
    tr: 'Rulo malzemeye eko solvent baskı; folyo, branda, araç giydirme. Baskı-kesim seçenekli.',
    en: 'Eco-solvent printing onto roll media: vinyl, banner, vehicle wraps. Print-and-cut optional.',
  },
  dtf: {
    tr: 'PET filme baskı, toz serpme ve fırınlama; preste kumaşa transfer. Kumaş rengi fark etmez.',
    en: 'Print to PET film, powder and cure, then transfer to fabric under a press. Fabric colour is irrelevant.',
  },
  sublimation: {
    tr: 'Transfer kağıdına baskı, kalenderde polyester life geçiş. Baskı lifin içindedir.',
    en: 'Print to transfer paper, then calender the dye into polyester fibre. The image sits inside the fibre.',
  },
  'uv-dtf': {
    tr: 'A/B film üzerine UV baskı ve laminasyon; ısı veya pres olmadan yapışan etiket.',
    en: 'UV print and lamination on A/B film, producing a label that needs no heat or press.',
  },
  cutting: {
    tr: 'Basılmış veya boş malzemede kontur, oluk ve delik kesimi. Vakumlu flatbed tabla.',
    en: 'Contour, crease and perforation cutting of printed or blank material on a vacuum bed.',
  },
};

/* --- editorial copy ----------------------------------------------------- */
const INTROS: Record<string, Record<Locale, string[]>> = {
  'uv-flatbed': {
    tr: [
      'UV flatbed makineler, malzemeyi sabit bir tabla üzerinde tutup baskı kafasını üzerinde gezdirir. Rulo makinelerin aksine cam, ahşap, alüminyum kompozit, pleksi ve 100 mm kalınlığa kadar levha doğrudan basılabilir — ara transfer, folyo veya kaplama gerekmez.',
      'Bu ailede belirleyici üç şey vardır: tabla ölçüsü, kafa sayısı ve vakum bölgesi düzeni. Tabla işinizin en büyük parçasını almalı; kafa sayısı doğrudan m²/sa hızını belirler; vakum bölgeleri ise küçük parça basarken tüm tablayı vakumlamak zorunda kalmamanızı sağlar.',
    ],
    en: [
      'A UV flatbed holds the material still on a table and moves the printhead over it. Unlike a roll machine it prints directly onto glass, wood, aluminium composite, acrylic and sheet up to 100 mm thick — with no transfer step, film or coating.',
      'Three things decide the machine in this family: bed size, head count and vacuum zoning. The bed has to take your largest piece; head count sets the m²/h; and the zones are what stop a single small panel from costing you a full table of vacuum.',
    ],
  },
  'uv-hybrid': {
    tr: [
      'Hibrit makineler tek şasede hem rulo hem levha basar. Rulo tarafında branda, folyo ve duvar kağıdı; levha tarafında genellikle 10–50 mm kalınlığa kadar rijit malzeme çalışır.',
      'Hibrit ile saf flatbed arasındaki kritik fark rijit taraftaki baskı yüksekliğidir: hibritlerde bu genellikle 10–50 mm ile sınırlıdır, saf flatbedlerde 100 mm’ye çıkar. Ağır rulo kapasitesi de ayrı bir seçenektir.',
    ],
    en: [
      'A hybrid prints both roll and rigid material on one chassis: banner, vinyl and wallcovering on the roll side, rigid sheet — usually 10 to 50 mm — on the flat side.',
      'The critical difference from a true flatbed is print height on the rigid side: hybrids are typically limited to 10–50 mm where a flatbed reaches 100 mm. Heavy roll capacity is a separate option.',
    ],
  },
  'eco-solvent': {
    tr: [
      'Eko solvent makineler, dış mekân dayanımı ile düşük koku arasındaki dengeyi kuran rulo yazıcılardır. Tabela, araç giydirme, vitrin folyosu ve branda işlerinin ana makinesidir.',
      'Baskı-kesim (print & cut) modelleri baskıdan sonra konturu aynı makinede keser; ayrı plotter, ayrı hizalama ve ikinci bir operasyon ortadan kalkar. Ayrı kesim hacminiz düzenli değilse bu modeller toplam maliyeti düşürür.',
    ],
    en: [
      'Eco-solvent roll printers sit at the balance point between outdoor durability and low odour. They are the workhorse for signage, vehicle graphics, window vinyl and banner.',
      'Print-and-cut models contour-cut on the same machine straight after printing, removing a separate plotter, a separate registration step and a second handling operation. If your cutting volume is irregular, that lowers total cost.',
    ],
  },
  dtf: {
    tr: [
      'DTF (Direct-to-Film) sistemleri tasarımı PET filme basar, üzerine sıcak eriyik toz serper, fırında eritir ve preste kumaşa aktarır. Kumaş rengi ve cinsi fark etmez; pamuk, polyester ve karışımlarda aynı şekilde çalışır.',
      'Sistem iki üniteden oluşur: yazıcı ve toz serpme/fırın ünitesi. Toz ünitesini ayrı almak ilk yatırımı düşürür gibi görünse de, iki ünitenin senkron çalışması üretim hızını doğrudan belirler.',
    ],
    en: [
      'DTF systems print onto PET film, apply hot-melt powder, cure it in an oven and transfer it to fabric under a press. Fabric colour and fibre do not matter — cotton, polyester and blends all behave the same.',
      'The system is two units: printer and powder shaker/oven. Buying the shaker separately looks cheaper, but how well the two units run in step is what actually sets your throughput.',
    ],
  },
  sublimation: {
    tr: [
      'Süblimasyon, mürekkebi transfer kağıdına basıp ısı ve basınçla polyester kumaşa gaz hâlinde geçirir. Baskı kumaşın yüzeyinde değil lifin içindedir; bu yüzden elle tutulmaz ve yıkamada solmaz.',
      'Sistem yazıcı ve kalenderden oluşur. Kalenderin tambur genişliği ve ısıtma yöntemi (yağlı/elektrikli), sonuçtaki renk tutarlılığını yazıcı kadar etkiler.',
    ],
    en: [
      'Dye-sublimation prints onto transfer paper, then heat and pressure move the dye into polyester fibre as a gas. The image sits inside the fibre, not on it, so there is no hand feel and no wash-out.',
      'The system is a printer plus a calender. The calender’s drum width and heating method — oil or electric — affect final colour consistency as much as the printer does.',
    ],
  },
  'uv-dtf': {
    tr: [
      'UV DTF, A film üzerine UV mürekkeple basıp B filmle laminasyon yapar. Ortaya çıkan etiket cam, metal, plastik, ahşap ve kavisli yüzeylere ısı veya pres olmadan yapışır.',
      'Kristal etiket adıyla da bilinen bu işin cazibesi düşük giriş maliyeti ve yüksek birim kârıdır; sınırı ise tekstile uygun olmamasıdır.',
    ],
    en: [
      'UV DTF prints UV ink onto an A film and laminates it with a B film. The resulting label sticks to glass, metal, plastic, wood and curved surfaces with no heat and no press.',
      'Also sold as crystal labels, the appeal is a low entry cost and a high margin per unit; the limit is that it is not a textile process.',
    ],
  },
  cutting: {
    tr: [
      'Dijital kesim sistemleri, basılmış veya boş malzemeyi kontur, oluk ve delik hattı boyunca keser. Ambalaj prototipi, stand, tabela kesimi ve etiket işlerinin son adımıdır.',
      'Bir kesiciyi belirleyen üç şey: kesim alanı, takım sayısı ve vakum bölgesi. Üç takımlı bir kafa, tek işte kesme-oluk açma-delme yapabildiği için malzemeyi tablada bir kez konumlandırmanız yeter.',
    ],
    en: [
      'Digital cutting systems cut printed or blank material along contour, crease and perforation lines. They are the last step for packaging prototypes, displays, cut signage and labels.',
      'Three things decide a cutter: working area, tool count and vacuum zoning. A three-tool head cuts, creases and perforates in one pass, so the material is positioned on the bed once.',
    ],
  },
};

// Descriptive, not persuasive: this section explains how the price is formed,
// which is the question behind the "fiyat/fiyatları" search modifier. It is not
// a place to sell.
const PRICE_COPY: Record<Locale, { h: string; body: string[] }> = {
  tr: {
    h: `${heading} fiyatı nasıl belirlenir`,
    body: [
      'Bu sınıfta tek bir liste fiyatı yoktur. Fiyatı belirleyen beş kalem şudur: baskı kafası markası ve sayısı, baskı genişliği veya tabla ölçüsü, mürekkep sistemi (kartuş, toplu tank, beyaz sirkülasyonun bulunup bulunmadığı), kurulum ve eğitimin kapsama dahil olup olmadığı, nakliye ile elektrik altyapısı.',
      'Aynı model, kafa sayısına göre iki katına varan fark gösterebilir. Teklif bu kalemler ayrı ayrı yazılarak hazırlanır; kurulum, eğitim ve garanti kapsamı da teklifte ayrıca belirtilir.',
    ],
  },
  en: {
    h: `How ${heading.toLowerCase()} are priced`,
    body: [
      'There is no single list price in this class. Five items set it: printhead brand and count, print width or bed size, the ink system (cartridge, bulk tank, whether white circulation is fitted), whether installation and training are in scope, and freight plus electrical work.',
      'The same model can differ by a factor of two on head count alone. A quote itemises each of these separately, and states the installation, training and warranty scope alongside them.',
    ],
  },
};

const intro = family ? INTROS[family]?.[locale] ?? [] : [];

/* --- card helpers -------------------------------------------------------- */
function cardSpecs(machine: CollectionEntry<'machines'>) {
  const d = machine.data;
  const out: Array<{ label: string; value: string }> = [];
  const push = (key: SpecKey) => {
    const raw = d.specs[key];
    if (raw === undefined) return;
    const def = SPECS[key];
    const unit = (raw as { unit?: string }).unit ?? def.unit?.[locale] ?? '';
    const value = typeof raw === 'object' && raw !== null && 'value' in raw
      ? `${range((raw as { value: number | [number, number] }).value, locale, unit)} ${unit}`.trim()
      : String(raw);
    out.push({ label: def[locale], value });
  };
  push(d.specs.printArea !== undefined ? 'printArea' : 'printWidth');
  out.push({
    label: SPECS.printHead[locale],
    value: `${HEAD_BRANDS[d.printhead.brand]} ${d.printhead.model} × ${
      Array.isArray(d.printhead.count) ? d.printhead.count.join('–') : d.printhead.count
    }`,
  });
  const fastest = d.speedModes[0];
  out.push({
    label: `${SPECS.speedModes[locale]} @${fastest.pass}`,
    value: `${range(fastest.value, locale)} ${tr ? 'm²/sa' : 'm²/h'}`,
  });
  push('colors');
  return out.slice(0, 4);
}

const FAQ: Record<Locale, Array<{ q: string; a: string }>> = {
  tr: [
    {
      q: 'Kurulum ve eğitim fiyata dahil mi?',
      a: 'Evet. Yerinde kurulum, ilk devreye alma ve operatör eğitimi teklif fiyatına dahildir. Nakliye, forklift/vinç, elektrik altyapısı ve havalandırma dahil değildir; bunlar her sahada farklı olduğu için ayrı kalemlenir.',
    },
    {
      q: 'Teslim süresi ne kadar?',
      a: 'Stokta olan modellerde 1–2 hafta, sipariş üzerine yapılandırılan makinelerde 6–10 hafta. Kesin süre kafa sayısı ve mürekkep sistemi seçiminize bağlıdır.',
    },
    {
      q: 'İkinci el makinemi takas edebilir miyim?',
      a: 'Değerlendiriyoruz. Marka, model, çalışma saati ve kafa durumu bilgisiyle gönderin; ekspertiz sonrası takas değeri veriyoruz.',
    },
    {
      q: 'Makineyi çalışırken görebilir miyim?',
      a: 'Evet. Showroomda kendi dosyanızla demo baskı alabilirsiniz. Randevu almanızı öneriyoruz; malzemenizi getirirseniz kendi işinizle test edersiniz.',
    },
  ],
  en: [
    {
      q: 'Are installation and training included?',
      a: 'Yes. On-site installation, commissioning and operator training are part of the quoted price. Freight, forklift or crane, electrical infrastructure and ventilation are not — they differ on every site and are itemised separately.',
    },
    {
      q: 'What is the lead time?',
      a: 'One to two weeks for stocked models, six to ten weeks for a configured build. The exact figure depends on head count and ink system.',
    },
    {
      q: 'Can I trade in my current machine?',
      a: 'We do consider it. Send the make, model, running hours and head condition; we quote a trade-in value after inspection.',
    },
    {
      q: 'Can I see the machine running?',
      a: 'Yes. You can take a demo print with your own file in the showroom. Book ahead, and bring your material so the test is on your actual job.',
    },
  ],
};

const title = family
  ? (tr ? `${heading} — Modeller ve Fiyat Teklifi | Maven` : `${heading} — Models and Pricing | Maven`)
  : (tr ? 'Dijital Baskı Makineleri — Tüm Modeller | Maven' : 'Digital Printing Machines — All Models | Maven');

const widths = machines
  .map((m) => m.data.specs.printWidth ?? m.data.specs.printArea)
  .filter(Boolean);

const description = tr
  ? `${machines.length} model ${heading.toLowerCase()}. Teknik özellikler, baskı kafası seçenekleri, uyumlu mürekkepler ve fiyat teklifi.`
  : `${machines.length} models of ${heading.toLowerCase()}. Specifications, printhead options, compatible inks and pricing.`;
---

<Base
  locale={locale}
  title={title}
  description={description}
  routeKey={routeKey}
  schema={[
    {
      '@type': 'ItemList',
      itemListElement: machines.map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: m.data.model,
        url: `${SITE.url}${machineHref(m, locale)}`,
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ[locale].map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <div data-ground="paper" data-accent="cyan">
    <div class="shell cat__crumbs">
      <Breadcrumb
        locale={locale}
        crumbs={family
          ? [{ label: t('navMachines', locale), href: path('machines', locale) }, { label: heading }]
          : [{ label: heading }]}
      />
    </div>

    <div class="shell">
      <header class="cat__head">
      <h1>{heading}</h1>
      {intro.map((p) => <p class="lead">{p}</p>)}
      {!family && (
        <p class="lead">
          {tr
            ? 'Yedi aile, on iki model. Aşağıdaki listede her makinenin tabla ölçüsü, kafa yapılandırması ve dört geçişteki üretim hızı yan yana durur.'
            : 'Seven families, twelve models. Bed size, head configuration and four-pass output for every machine, side by side.'}
        </p>
      )}
    </header>
    </div>

    <section class="shell cat__grid-wrap">
      {groups.map((group) => (
        <div class="fam" data-rail-group>
          {!family && (
            <div class="fam__head">
              <h2 class="fam__title">
                <a class="link" href={path(machineFamilyRoute(group.key), locale)}>
                  {machineFamilyName(group.key, locale)}
                </a>
              </h2>
              <p class="fam__role muted">{FAMILY_ROLE[group.key]?.[locale] ?? ''}</p>
              <span class="fam__count mono">
                {group.machines.length} {t('models', locale)}
              </span>
            </div>
          )}

          <RailHead locale={locale} />

          <ul class="cards cards--2" role="list" data-stagger data-rail>
            {group.machines.map((m) => {
              const render = renderFor(m.data.sku, true);
              return (
                <li class="card" data-accent="cyan">
                  <a class="pcard" href={machineHref(m, locale)}>
                    <span class="pcard__media">
                      {render
                        ? <Picture src={render} alt={m.data.gallery[0]?.alt[locale] ?? m.data.model}
                                   ratio="card" graded={false} sizes="(min-width: 1024px) 40vw, 92vw" />
                        : (
                          <span class="pcard__noimg">
                            <span class="pcard__noimg-mark code" lang="en">{m.data.sku}</span>
                            <span class="pcard__noimg-note mono">
                              {tr ? 'görsel hazırlanıyor' : 'imagery in production'}
                            </span>
                          </span>
                        )}
                    </span>
                    <span class="pcard__body">
                      <span class="pcard__model code" lang="en">{m.data.model}</span>
                      <span class="pcard__tagline muted">{m.data.i18n[locale].tagline}</span>
                      <span class="pcard__specs">
                        {cardSpecs(m).map((s) => (
                          <span class="pcard__spec">
                            <span class="pcard__spec-l">{s.label}</span>
                            <span class="pcard__spec-v mono">{s.value}</span>
                          </span>
                        ))}
                      </span>
                      <span class="pcard__cta">
                        {t('explore', locale)} <span class="arrow" aria-hidden="true">›</span>
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </section>
  </div>

  <!-- The highest-leverage SEO surface on the site: Turkish buyers attach
       "fiyat/fiyatları" to almost every query, and we publish no prices. -->
  <section class="section" data-ground="bone" data-accent="cyan">
    <div class="shell grid">
      <div class="section__label"><p class="eyebrow">{tr ? 'FİYAT' : 'PRICING'}</p></div>
      <div class="section__body">
        <h2 class="reveal">{PRICE_COPY[locale].h}</h2>
        {PRICE_COPY[locale].body.map((p) => <p class="lead reveal">{p}</p>)}
        <a class="btn reveal" href={path('quote', locale)}>
          {t('getQuote', locale)}<span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--ruled" data-ground="paper" data-accent="cyan">
    <div class="shell grid">
      <div class="section__label"><p class="eyebrow">{tr ? 'SORULAR' : 'QUESTIONS'}</p></div>
      <div class="section__body">
        <h2 class="reveal">{t('faq', locale)}</h2>
        <div class="faq reveal">
          {FAQ[locale].map((item, i) => (
            <details name="cat-faq" open={i === 0}>
              <summary>
                <span>{item.q}</span>
                <span class="accordion__chevron" aria-hidden="true">⌄</span>
              </summary>
              <div class="accordion__panel"><div><p>{item.a}</p></div></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .cat__crumbs {
    padding-block: var(--sp-5) var(--sp-7);
  }

  /* `max-width` must NOT sit on the same element as `.shell`. The shell centres
     itself with `margin-inline: auto`, so a narrower max-width on it centres the
     measure instead of the page: the h1 drifted right as the viewport grew
     (105px at 1024, 295px at 1440) while every h2 below stayed on the grid.
     The shell is now the outer box and the measure an inner one. Subtracting the
     page margin keeps the rendered line length identical — the old value sat on
     a padded border-box, this one on content. */
  .cat__head {
    display: grid;
    gap: var(--sp-5);
    padding-block-end: var(--sp-8);
    max-width: calc(78ch - var(--page-margin) * 2);
  }

  .cat__head .lead {
    color: var(--muted);
  }

  .cat__grid-wrap {
    padding-block-end: var(--section-pad);
  }

  .fam + .fam {
    margin-block-start: var(--sp-10);
  }

  .fam__head {
    display: grid;
    gap: var(--sp-2);
    padding-block-end: var(--sp-6);
    margin-block-end: var(--sp-6);
    border-bottom: var(--border) solid var(--rule);
  }

  @media (min-width: 1024px) {
    .fam__head {
      grid-template-columns: minmax(0, 22ch) minmax(0, 1fr) auto;
      align-items: baseline;
      gap: var(--gutter);
    }
  }

  .fam__title {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .fam__title a {
    color: inherit;
  }

  .fam__role {
    font-size: var(--step--1);
    max-width: 62ch;
  }

  .fam__count {
    font-size: var(--step--2);
    color: var(--muted);
    white-space: nowrap;
  }

  .pcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .pcard__media {
    display: block;
    flex: none;
    background: var(--bone);
    overflow: hidden;
  }

  /* An honest placeholder, not a fake photograph: it names the model and says
     plainly that the imagery is still being produced. */
  .pcard__noimg {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--sp-3);
    aspect-ratio: 3 / 2;
    background: var(--bone);
    border-bottom: var(--border) solid var(--hairline);
  }

  .pcard__noimg-mark {
    font-size: var(--step-2);
    color: color-mix(in srgb, var(--ink) 24%, transparent);
