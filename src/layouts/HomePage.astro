---
import { getCollection } from 'astro:content';

import { SITE, type Locale } from '../config/site';
import { FAMILY_ROUTE, INK_FAMILY_ROUTE, path, ROUTES } from '../i18n/routes';
import { t } from '../i18n/ui';
import { CHANNELS, type ChannelCode } from '../i18n/specs';
import Base from './Base.astro';
import HeroSlider from '../components/media/HeroSlider.astro';
import ApplicationIcon from '../components/ui/ApplicationIcon.astro';
import RailHead from '../components/ui/RailHead.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = locale === 'tr';

const machines = (await getCollection('machines'))
  .filter((m) => m.data.status !== 'discontinued')
  .sort((a, b) => a.data.order - b.data.order);

const FAMILIES = [
  {
    key: 'uv-flatbed',
    tr: { name: 'UV Flatbed', role: 'Rijit malzemeye doğrudan baskı' },
    en: { name: 'UV Flatbed', role: 'Direct printing onto rigid material' },
    chips: ['600×900 – 3200×2000 mm', 'Ricoh · Konica · Epson', '2–18 kafa'],
  },
  {
    key: 'uv-hybrid',
    tr: { name: 'UV Hibrit', role: 'Rulo ve levha, tek şasi' },
    en: { name: 'UV Hybrid', role: 'Roll and rigid, one chassis' },
    chips: ['1,8 – 3,2 m', 'LED-UV', '92–111 m²/sa'],
  },
  {
    key: 'eco-solvent',
    tr: { name: 'Eko Solvent', role: 'Folyo, branda, araç giydirme' },
    en: { name: 'Eco-Solvent', role: 'Vinyl, banner, vehicle wraps' },
    chips: ['1,6 – 1,8 m', 'Epson i3200-E1', 'Baskı + kesim'],
  },
  {
    key: 'dtf',
    tr: { name: 'DTF Sistemleri', role: 'Film transferi ile tekstil' },
    en: { name: 'DTF Systems', role: 'Textile via film transfer' },
    chips: ['30 – 60 cm', 'Toz serpme ünitesi', 'Duman filtresi'],
  },
  {
    key: 'sublimation',
    tr: { name: 'Süblimasyon', role: 'Bayrak, sportif tekstil, promosyon' },
    en: { name: 'Dye-Sublimation', role: 'Flags, sportswear, promotional' },
    chips: ['1,9 m', '180 m²/sa @2-pass', 'Kalender ile sistem'],
  },
  {
    key: 'uv-dtf',
    tr: { name: 'UV DTF / Kristal Etiket', role: 'Her yüzeye yapışan etiket' },
    en: { name: 'UV DTF / Crystal Label', role: 'Labels that stick to anything' },
    chips: ['30 cm', 'A/B film laminasyon', 'CMYK + W + Lak'],
  },
  {
    key: 'cutting',
    tr: { name: 'Kesim Makineleri', role: 'Dijital flatbed kesim ve plotter' },
    en: { name: 'Cutting Systems', role: 'Digital flatbed cutting and plotters' },
    chips: ['1600×1200 mm', '1000 mm/s', '±0,05 mm'],
  },
] as const;

const INK_FAMILIES = [
  { key: 'uv', tr: 'UV Mürekkep', en: 'UV Inks' },
  { key: 'uv-led', tr: 'UV LED Mürekkep', en: 'UV-LED Inks' },
  { key: 'uv-dtf', tr: 'UV DTF Mürekkep', en: 'UV DTF Inks' },
  { key: 'eco-solvent', tr: 'Eko Solvent Mürekkep', en: 'Eco-Solvent Inks' },
  { key: 'solvent', tr: 'Solvent Mürekkep', en: 'Solvent Inks' },
  { key: 'sublimation', tr: 'Süblimasyon Mürekkebi', en: 'Dye-Sublimation Inks' },
  { key: 'dtf', tr: 'DTF Pigment Mürekkep', en: 'DTF Pigment Inks' },
  { key: 'textile-pigment', tr: 'Tekstil Pigment Mürekkebi', en: 'Textile Pigment Inks' },
] as const;

/**
 * Hero slides — one per machine that has its own render.
 *
 * Written the way the trade writes a spec line: the model, the real figures,
 * the materials it takes, and what it does with them. No adjectives about the
 * company, no promises, nothing that could not be checked on the product page.
 */
const HERO_SLIDES = [
  {
    image: 'machines/flatbed-uv/cutout/light/flatbed-uv-hero',
    eyebrow: tr ? 'UV Flatbed Baskı Makineleri' : 'UV Flatbed Printers',
    model: 'Maven MF-2513 R8',
    href: path('machines', locale, [
      ROUTES['machines.uvFlatbed'][locale], 'mf-2513-r8',
    ]),
    body: tr
      ? '2500 × 1300 mm tabla · 2–12 Ricoh Gen6 kafa · 4 geçişte 50–60 m²/sa'
      : '2500 × 1300 mm bed · 2–12 Ricoh Gen6 heads · 50–60 m²/h at 4 passes',
    alt: tr
      ? 'Maven MF-2513 R8 UV flatbed baskı makinesi'
      : 'Maven MF-2513 R8 UV flatbed printer',
  },
  {
    image: 'machines/roll-uv/cutout/light/roll-uv-hero',
    eyebrow: tr ? 'UV Hibrit Baskı Makineleri' : 'UV Hybrid Printers',
    model: 'Maven MH-3200 R12',
    href: path('machines', locale, [
      ROUTES['machines.uvHybrid'][locale], 'mh-3200-r12',
    ]),
    body: tr
      ? '3200 mm baskı genişliği · rulo ve levha · 4 geçişte 92–111 m²/sa'
      : '3200 mm print width · roll and rigid · 92–111 m²/h at 4 passes',
    alt: tr
      ? 'Maven MH-3200 R12 UV hibrit rulodan ruloya baskı makinesi'
      : 'Maven MH-3200 R12 UV hybrid roll-to-roll printer',
  },
  {
    image: 'machines/eco-solvent/cutout/light/eco-solvent-hero',
    eyebrow: tr ? 'Eko Solvent Baskı Makineleri' : 'Eco-Solvent Printers',
    model: 'Maven MS-1802 E4',
    href: path('machines', locale, [
      ROUTES['machines.ecoSolvent'][locale], 'ms-1802-e4',
    ]),
    body: tr
      ? '1800 mm rulo · 4 × Epson i3200-E1 · üretim modunda 79 m²/sa'
      : '1800 mm roll width · 4 × Epson i3200-E1 · 79 m²/h in production',
    alt: tr
      ? 'Maven MS-1802 E4 eko solvent rulo baskı makinesi'
      : 'Maven MS-1802 E4 eco-solvent roll printer',
  },
  {
    image: 'machines/dtf/cutout/light/dtf-hero',
    eyebrow: tr ? 'DTF Baskı Sistemleri' : 'DTF Printing Systems',
    model: 'Maven MD-600 A4',
    href: path('machines', locale, [
      ROUTES['machines.dtf'][locale], 'md-600-a4',
    ]),
    body: tr
      ? '600 mm film · 4 × Epson i3200-A1 · toz serpme ve fırın ünitesi dahil'
      : '600 mm film · 4 × Epson i3200-A1 · powder shaker and oven included',
    alt: tr
      ? 'Maven MD-600 A4 DTF baskı sistemi ve toz serpme ünitesi'
      : 'Maven MD-600 A4 DTF printing system with powder shaker',
  },
];

const CHANNEL_SET: ChannelCode[] = ['C', 'M', 'Y', 'K', 'Lc', 'Lm', 'Or', 'Gr', 'W', 'Cl'];

/* One process colour per sector, cycled through the three the brand already
   owns. Inventing a sixth hue for a sixth tile would be the moment this stops
   looking like one company's identity and starts looking like a colour picker. */
const APPLICATIONS = [
  { key: 'applications.signage', icon: 'signage', accent: 'cyan', tr: 'Reklam ve Tabela', en: 'Signage & Advertising' },
  { key: 'applications.packaging', icon: 'packaging', accent: 'magenta', tr: 'Ambalaj ve Etiket', en: 'Packaging & Labels' },
  { key: 'applications.interior', icon: 'interior', accent: 'yellow', tr: 'Mobilya ve Dekorasyon', en: 'Furniture & Interior' },
  { key: 'applications.industrial', icon: 'industrial', accent: 'cyan', tr: 'Cam, Metal ve Endüstriyel', en: 'Glass, Metal & Industrial' },
  { key: 'applications.textile', icon: 'textile', accent: 'magenta', tr: 'Tekstil ve Promosyon', en: 'Textile & Promotional' },
  { key: 'applications.vehicle', icon: 'vehicle', accent: 'yellow', tr: 'Araç Giydirme', en: 'Vehicle Wrapping' },
] as const;

const COMMITMENTS = tr
  ? [
      { n: '01', h: `${SITE.commitments.responseHours} saat içinde müdahale`, b: 'Arıza kaydınız açıldığı andan itibaren en geç 24 saat içinde uzaktan bağlanır, gerekiyorsa yerinde ekip planlanır.' },
      { n: '02', h: 'Garanti kapsamı', b: `Elektronik aksam ${SITE.commitments.warrantyElectronicMonths} ay, mekanik aksam ${SITE.commitments.warrantyMechanicalMonths} ay. Baskı kafası, sarf malzemesi ve operatör kaynaklı hasar garanti dışıdır.` },
      { n: '03', h: 'Kritik yedek parça stokta', b: 'Baskı kafası, dampers, kayış, encoder şerit ve pompa gibi üretimi durduran kalemler İstanbul deposunda tutulur.' },
      { n: '04', h: 'Operatör eğitimi', b: 'Kurulum sonrası yerinde verilir; süre makinenin devreye alınmasına göre değişir. Personel değişiminde tekrar eğitim kapsam dahilindedir.' },
      { n: '05', h: `${SITE.commitments.onSiteCities.length} şehirde yerinde servis`, b: SITE.commitments.onSiteCities.join(' · ') },
      { n: '06', h: 'Kurulum öncesi keşif', b: 'Elektrik altyapısı, zemin taşıma kapasitesi, kapı ve asansör ölçüleri ile havalandırma sevkiyat öncesinde yerinde kontrol edilir.' },
    ]
  : [
      { n: '01', h: `Response within ${SITE.commitments.responseHours} hours`, b: 'From the moment a fault is logged we connect remotely within 24 hours and schedule an on-site engineer if needed.' },
      { n: '02', h: 'Warranty scope', b: `Electronics ${SITE.commitments.warrantyElectronicMonths} months, mechanical parts ${SITE.commitments.warrantyMechanicalMonths} months. Printheads, consumables and operator-caused damage are outside warranty.` },
      { n: '03', h: 'Critical spares in stock', b: 'Printheads, dampers, belts, encoder strips and pumps — the items that stop production — are held in Istanbul.' },
      { n: '04', h: 'Operator training', b: 'Delivered on site after installation; duration depends on commissioning. Repeat training after a staff change is in scope.' },
      { n: '05', h: `On-site service in ${SITE.commitments.onSiteCities.length} cities`, b: SITE.commitments.onSiteCities.join(' · ') },
      { n: '06', h: 'Pre-installation survey', b: 'Electrical supply, floor loading, door and lift dimensions and ventilation are checked on site before despatch.' },
    ];

const familyCount = (key: string) => machines.filter((m) => m.data.family === key).length;

const title = tr
  ? 'Dijital Baskı Makineleri ve Mürekkep | Maven'
  : 'Digital Printing Machines and Inks | Maven';
const description = tr
  ? 'UV flatbed, hibrit, eko solvent, DTF ve süblimasyon baskı makineleri, mürekkep ve sarf malzemeleri, 24 saat içinde teknik servis. Teklif alın.'
  : 'UV flatbed, hybrid, eco-solvent, DTF and dye-sublimation printers, inks and consumables, technical service within 24 hours. Request a quote.';
---

<Base
  locale={locale}
  title={title}
  description={description}
  routeKey="home"
  schema={[{
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.brand.name,
    inLanguage: locale,
    publisher: { '@id': `${SITE.url}/#organization` },
  }]}
>
  <!-- 1 — HERO SLIDER ------------------------------------------------------ -->
  <HeroSlider
    locale={locale}
    heading={tr
      ? 'Dijital baskı makineleri, mürekkepleri ve teknik servis.'
      : 'Digital printing machines, inks and technical service.'}
    intro={tr
      ? 'Yedi makine ailesi, sekiz mürekkep serisi, on iki şehirde yerinde servis.'
      : 'Seven machine families, eight ink series, on-site service in twelve cities.'}
    slides={HERO_SLIDES}
  />


  <!-- 2 — APPLICATIONS ------------------------------------------------------ -->
  <section class="section section--ruled" data-ground="paper">
    <div class="shell grid">
      <div class="section__label">
        <p class="eyebrow">01 — {tr ? 'UYGULAMALAR' : 'APPLICATIONS'}</p>
      </div>
      <div class="section__body" data-rail-group>
        <h2 class="reveal">{tr ? 'Kullanım Alanları' : 'Applications'}</h2>
        <p class="lead muted reveal">
          {tr
            ? 'Altı sektör. Her sayfada o işi yapan makineler ve mürekkepler listelenir.'
            : 'Six sectors. Each page lists the machines and inks that do that work.'}
        </p>
        <RailHead locale={locale} />
        <ul class="tiles reveal" role="list" data-stagger data-rail>
          {APPLICATIONS.map((a) => (
            <li class="tile" data-accent={a.accent}>
              <a href={path(a.key, locale)}>
                <span class="tile__icon">
                  <ApplicationIcon name={a.icon} />
                </span>
                <span class="tile__label">{a[locale]}</span>
                <span class="tile__go arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 3 — MACHINES --------------------------------------------------------- -->
  <section class="section section--ruled" data-ground="paper" data-accent="cyan">
    <div class="shell grid">
      <div class="section__label">
        <p class="eyebrow">02 — {tr ? 'MAKİNELER' : 'MACHINES'}</p>
      </div>
      <div class="section__body" data-rail-group>
        <h2 class="reveal">
          {tr ? 'Makineler' : 'Machines'}
        </h2>
        <p class="lead muted reveal">
          {tr
            ? 'Yedi aile, yedi baskı yöntemi. Mürekkep ve malzeme aileye göre değişir.'
            : 'Seven families, seven processes. Ink and material follow from the process.'}
        </p>

        <RailHead locale={locale} />
        <ul class="cards reveal" role="list" data-stagger data-rail>
          {FAMILIES.map((f) => (
            <li class="card" data-accent="cyan">
              <a class="card__link" href={path(FAMILY_ROUTE[f.key], locale)}>
                <span class="card__head">
                  <span class="card__title">{f[locale].name}</span>
                  <span class="card__count mono">
                    {familyCount(f.key)} {t('models', locale)}
                  </span>
                </span>
                <span class="card__role muted">{f[locale].role}</span>
                <span class="card__chips">
                  {f.chips.map((c) => <span class="chip mono">{c}</span>)}
                </span>
                <span class="card__cta">
                  {t('explore', locale)} <span class="arrow" aria-hidden="true">›</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 4 — INKS ------------------------------------------------------------- -->
  <section class="section" data-ground="bone" data-accent="magenta">
    <div class="shell grid">
      <div class="section__label">
        <p class="eyebrow">03 — {tr ? 'MÜREKKEP & SARF' : 'INKS & SUPPLIES'}</p>
      </div>
      <div class="section__body" data-rail-group>
        <h2 class="reveal">
          {tr ? 'Mürekkep ve Sarf Malzemeleri' : 'Inks and Consumables'}
        </h2>

        <!-- The channel strip: the site's signature component. Real swatches,
             white and varnish as outlined/hatched chips. -->
        <ul class="channels reveal" role="list" aria-label={t('channels', locale)}>
          {CHANNEL_SET.map((code) => {
            const ch = CHANNELS[code] as { tr: string; en: string; hex: string; outlined?: boolean; hatched?: boolean };
            return (
              <li class="channel">
                <span
                  class:list={['channel__swatch', { 'is-outlined': ch.outlined, 'is-hatched': ch.hatched }]}
                  style={`--swatch:${ch.hex}`}
                  aria-hidden="true"
                ></span>
                <span class="channel__code mono">{code}</span>
                <span class="channel__name">{ch[locale]}</span>
              </li>
            );
          })}
        </ul>

        <p class="lead reveal">
          {tr
            ? 'Güvenlik Bilgi Formları'
            : 'Safety Data Sheets'}
          {' '}
          <a class="link link--inline" href={path('documents', locale)}>
            {tr ? 'Belgeler' : 'Documents'} <span class="arrow" aria-hidden="true">›</span>
          </a>
        </p>

        <ul class="ink-families reveal" role="list">
          {INK_FAMILIES.map((f) => (
            <li>
              <a class="link" href={path(INK_FAMILY_ROUTE[f.key], locale)}>{f[locale]}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 5 — COMPATIBILITY TEASER --------------------------------------------- -->
  <section class="section section--tight" data-ground="bone" data-accent="magenta">
    <div class="shell grid">
      <div class="section__label">
        <p class="eyebrow">04 — {tr ? 'UYUMLULUK' : 'COMPATIBILITY'}</p>
      </div>
      <div class="section__body" data-rail-group>
        <h3 class="reveal">
          {tr ? 'Makine – Mürekkep Uyumluluğu' : 'Machine – Ink Compatibility'}
        </h3>
        <div class="table-wrap reveal">
          <table class="spec-table compat">
            <caption class="visually-hidden">
              {tr ? 'Makine – mürekkep uyumluluk tablosu özeti' : 'Machine–ink compatibility excerpt'}
            </caption>
            <thead>
              <tr>
                <th scope="col">{tr ? 'Makine' : 'Machine'}</th>
                <th scope="col">{tr ? 'Baskı Kafası' : 'Printhead'}</th>
                <th scope="col">{tr ? 'Uyumlu Mürekkep' : 'Compatible Ink'}</th>
                <th scope="col">{tr ? 'Geçiş' : 'Changeover'}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Maven MF-2513 R8</td><td>Ricoh Gen6</td><td>MI-210 UV-LED R</td>
                <td>{t('switchAndMatch', locale)}</td>
              </tr>
              <tr>
                <td>Maven MS-1802 E4</td><td>Epson i3200-E1</td><td>MI-410 ECO</td>
                <td>{t('switchAndSwap', locale)}</td>
              </tr>
              <tr>
                <td>Maven MD-600 A4</td><td>Epson i3200-A1</td><td>MI-710 DTF</td>
                <td>{t('switchAndPrint', locale)}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <a class="link link--accent" href={path('compatibility', locale)}>
          {t('openTable', locale)} <span class="arrow" aria-hidden="true">›</span>
        </a>
      </div>
    </div>
  </section>


  <!-- 7 — SERVICE ----------------------------------------------------------- -->
  <section class="section" data-ground="ink" data-accent="yellow">
    <div class="shell grid">
      <div class="section__label">
        <p class="eyebrow">05 — {tr ? 'TEKNİK SERVİS' : 'SERVICE'}</p>
      </div>
      <div class="section__body" data-rail-group>
        <h2 class="reveal">
          {tr ? 'Teknik Servis' : 'Technical Service'}
        </h2>
        <ol class="commitments reveal" role="list" data-stagger>
          {COMMITMENTS.map((c) => (
            <li class="commitment">
              <span class="commitment__n mono">{c.n}</span>
              <h3 class="commitment__h">{c.h}</h3>
            </li>
          ))}
        </ol>
        <a class="btn btn--outline" href={path('service.request', locale)}>
          {t('serviceRequest', locale)}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 8 — CTA BAND (seamless into the footer, no rule) ---------------------- -->
  <section class="cta" data-ground="ink" data-accent="cyan">
    <div class="shell">
      <h2 class="cta__h">
        {tr ? 'Teklif ve Teknik Bilgi' : 'Quotes and Technical Information'}
      </h2>
      <p class="lead muted">
        {tr
          ? 'Malzeme ve günlük hacim bilgisiyle yapılandırma ve fiyat kalemleri çıkarılır.'
          : 'Configuration and price items follow from the material and the daily volume.'}
      </p>
      <div class="cluster">
        <a class="btn btn--outline" href={path('quote', locale)}>
          {t('getQuote', locale)}<span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="link link--accent" href={`tel:${SITE.contact.phone.e164}`}>
          {SITE.contact.phone.display[locale]}
        </a>
        <a
          class="link link--accent"
          href={`https://wa.me/${SITE.contact.whatsapp.e164}?text=${encodeURIComponent(SITE.contact.whatsapp.prefill[locale])}`}
          target="_blank"
          rel="noopener"
        >WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- proof strip --- */
  .proof {
    padding-block: var(--sp-7);
    border-block: var(--border) solid var(--rule);
  }

  .proof__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-6) var(--gutter);
    margin: 0;
  }

  @media (min-width: 640px) {
    .proof__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .proof dt {
    margin-block-end: var(--sp-2);
  }

  .proof dd {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variation-settings: 'wdth' 88;
  }

  .proof .counter {
    font-weight: 500;
  }

  /* --- machine cards ---
     No `padding: 0` here. It was undoing the list reset, which now carries no
     specificity of its own, and as a scoped rule it outranked the mobile rail's
     own padding — the rail bleeds to the screen edge with a matching pad so its
     cards stay on the page margin, and killing the pad put the first card at
     x=0 while every heading beside it sat at x=20. */
  .cards {
    margin-block-start: var(--sp-8);
  }

  .card__link {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: var(--sp-6);
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .card__title {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .card__count {
    font-size: var(--step--2);
    color: var(--muted);
    white-space: nowrap;
  }

  .card__role {
    font-size: var(--step--1);
  }

  .card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    align-content: start;
  }

  .chip {
    font-size: var(--step--2);
    padding: 4px 8px;
    border: var(--border) solid var(--hairline);
    color: var(--muted);
    white-space: nowrap;
  }

  .card__cta {
    font-size: var(--step--1);
    font-weight: 500;
    margin-block-start: auto;
    padding-block-start: var(--sp-3);
  }

  /* --- channel strip --- */
  .channels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5) var(--sp-4);
    margin-block: var(--sp-8);
    padding: 0;
  }

  .channel {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto auto;
    gap: 2px var(--sp-2);
    align-items: center;
  }

  .channel__swatch {
    grid-row: span 2;
    width: 34px;
    height: 34px;
    background: var(--swatch);
  }

  .channel__swatch.is-outlined {
