---
import { getCollection } from 'astro:content';

import { SITE, type Locale } from '../config/site';
import { INK_FAMILY_ROUTE, path, type RouteKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import { CHANNELS, type ChannelCode } from '../i18n/specs';
import { inkFamilyName, inkFamilyRoute, inkHref } from '../lib/product';
import Base from './Base.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

export interface Props {
  locale: Locale;
  family?: string;
}

const { locale, family } = Astro.props;
const tr = locale === 'tr';

const all = (await getCollection('inks')).sort((a, b) => a.data.order - b.data.order);
const inks = family ? all.filter((i) => i.data.family === family) : all;

const routeKey: RouteKey = family ? inkFamilyRoute(family) : 'inks';
const heading = family ? inkFamilyName(family, locale) : t('navInks', locale);

const FAMILY_ORDER = [
  'uv', 'uv-led', 'uv-dtf', 'eco-solvent', 'solvent',
  'sublimation', 'dtf', 'textile-pigment', 'auxiliary',
] as const;

/** One factual line per family: the chemistry and where it applies. */
const FAMILY_ROLE: Record<string, Record<Locale, string>> = {
  uv: {
    tr: 'Cıva buharlı UV lamba ile kürlenir. Endüstriyel flatbed makinelerde, rijit malzemede kullanılır.',
    en: 'Cured by mercury-vapour UV lamp. Used on industrial flatbeds, on rigid material.',
  },
  'uv-led': {
    tr: '395 nm LED ile kürlenir; daha düşük lamba sıcaklığı sayesinde ince ve ısıya duyarlı malzemede çalışır.',
    en: 'Cured by 395 nm LED. The lower lamp temperature allows thin and heat-sensitive material.',
  },
  'uv-dtf': {
    tr: 'A film üzerine basılır, B film ile lamine edilir. Isı veya pres gerektirmeden yüzeye yapışır.',
    en: 'Printed onto an A film and laminated with a B film. Adheres with no heat and no press.',
  },
  'eco-solvent': {
    tr: 'Düşük koku, ısıtıcı ile kurutma. Folyo, branda ve araç giydirme malzemelerinde kullanılır.',
    en: 'Low odour, dried by heaters. Used on vinyl, banner and vehicle wrap media.',
  },
  solvent: {
    tr: 'Gerçek solvent; en düşük m² maliyeti ve en yüksek dış mekân dayanımı. Havalandırma zorunludur.',
    en: 'True solvent: the lowest cost per m² and the highest outdoor durability. Ventilation is mandatory.',
  },
  sublimation: {
    tr: 'Transfer kağıdına basılır, kalenderde ısı ve basınçla polyester life geçer.',
    en: 'Printed onto transfer paper, then moved into polyester fibre by heat and pressure in a calender.',
  },
  dtf: {
    tr: 'Su bazlı pigment; PET filme basılır, sıcak eriyik toz ile fırınlanır, preste kumaşa aktarılır.',
    en: 'Water-based pigment: printed to PET film, cured with hot-melt powder, pressed onto fabric.',
  },
  'textile-pigment': {
    tr: 'Doğrudan tekstile baskı. Ön işlem sıvısı gerektirir, fiksaj ısı ile yapılır.',
    en: 'Printed directly onto textile. Requires pre-treatment liquid; fixation is by heat.',
  },
  auxiliary: {
    tr: 'Temizleme sıvısı, yapışma artırıcı primer, DTF tozu ve transfer filmi.',
    en: 'Cleaning fluid, adhesion primer, DTF powder and transfer film.',
  },
};

// Grouped by chemistry rather than one flat list: a buyer arrives knowing his
// process, and the family is what decides whether a product can run at all.
const groups = family
  ? [{ key: family, inks }]
  : FAMILY_ORDER
      .map((key) => ({ key, inks: all.filter((i) => i.data.family === key) }))
      .filter((g) => g.inks.length > 0);

const INTRO: Record<Locale, string[]> = {
  tr: [
    'Mürekkepler kimya ailesine göre gruplanır: UV, UV LED, UV DTF, eko solvent, solvent, süblimasyon, DTF pigment ve tekstil pigment. Her ailenin kürleme yöntemi, uygulanabilir yüzeyleri ve raf ömrü farklıdır.',
    'Her ürün, çalıştığı baskı kafaları ve doğrulandığı makinelerle birlikte listelenir. Ürün adının yanındaki geçiş etiketi, mevcut mürekkepten geçerken sistemin yıkanması veya renk profilinin yeniden çıkarılması gerekip gerekmediğini gösterir.',
  ],
  en: [
    'Inks are grouped by chemistry: UV, UV-LED, UV DTF, eco-solvent, solvent, dye-sublimation, DTF pigment and textile pigment. Each family differs in curing method, suitable surfaces and shelf life.',
    'Every product is listed with the printheads it runs in and the machines it has been validated on. The changeover label beside each name states whether switching from the current ink requires flushing the system or rebuilding colour profiles.',
  ],
};

const CHANGEOVER_KEY = {
  'switch-and-print': 'switchAndPrint',
  'switch-and-swap': 'switchAndSwap',
  'switch-and-match': 'switchAndMatch',
} as const;

const title = family
  ? (tr ? `${heading} — Uyumlu Makineler ve Fiyat | Maven` : `${heading} — Compatible Equipment | Maven`)
  : (tr ? 'Dijital Baskı Mürekkepleri ve Sarf Malzemeleri | Maven' : 'Digital Printing Inks and Supplies | Maven');

const description = tr
  ? `${inks.length} ürün. Uyumlu baskı kafaları ve makineler, ambalaj seçenekleri, Türkçe Güvenlik Bilgi Formu. Teklif isteyin.`
  : `${inks.length} products. Compatible printheads and equipment, packaging options, safety data sheets. Request a quote.`;
---

<Base
  locale={locale}
  title={title}
  description={description}
  routeKey={routeKey}
  schema={[{
    '@type': 'ItemList',
    itemListElement: inks.map((i, n) => ({
      '@type': 'ListItem', position: n + 1, name: i.data.series,
      url: `${SITE.url}${inkHref(i, locale)}`,
    })),
  }]}
>
  <div data-ground="paper" data-accent="magenta">
    <div class="shell ink-idx__crumbs">
      <Breadcrumb
        locale={locale}
        crumbs={family
          ? [{ label: t('navInks', locale), href: path('inks', locale) }, { label: heading }]
          : [{ label: heading }]}
      />
    </div>

    <header class="shell ink-idx__head">
      <h1>{heading}</h1>
      {!family && INTRO[locale].map((p) => <p class="lead">{p}</p>)}
      {family && (
        <p class="lead">
          {inks[0]?.data.i18n[locale].role ?? ''}
        </p>
      )}
    </header>

    {!family && (
      <nav class="shell fam-nav" aria-label={heading}>
        <ul role="list">
          {FAMILY_ORDER.map((key) => {
            const count = all.filter((i) => i.data.family === key).length;
            if (!count) return null;
            return (
              <li>
                <a class="link link--accent" href={path(INK_FAMILY_ROUTE[key], locale)}>
                  {inkFamilyName(key, locale)}
                  <span class="fam-nav__n mono"> {count}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    )}

    <section class="shell ink-idx__list">
      {groups.map((group) => (
        <div class="fam">
          {!family && (
            <div class="fam__head">
              <h2 class="fam__title">
                <a class="link" href={path(INK_FAMILY_ROUTE[group.key as keyof typeof INK_FAMILY_ROUTE], locale)}>
                  {inkFamilyName(group.key, locale)}
                </a>
              </h2>
              <p class="fam__role muted">{FAMILY_ROLE[group.key]?.[locale] ?? ''}</p>
              <span class="fam__count mono">{group.inks.length}</span>
            </div>
          )}

      <ul role="list" class="ink-rows" data-stagger>
        {group.inks.map((ink) => (
          <li class="ink-row reveal">
            <a href={inkHref(ink, locale)}>
              <span class="ink-row__main">
                <span class="ink-row__series code" lang="en">{ink.data.series}</span>
                <span class="ink-row__role muted">{ink.data.i18n[locale].role}</span>
              </span>

              <span class="ink-row__swatches" aria-hidden="true">
                {ink.data.channels.slice(0, 10).map((ch) => {
                  const def = CHANNELS[ch.code as ChannelCode];
                  if (!def) return null;
                  return (
                    <span
                      class:list={['ink-row__sw', {
                        'is-outlined': (def as { outlined?: boolean }).outlined,
                        'is-hatched': (def as { hatched?: boolean }).hatched,
                      }]}
                      style={`--swatch:${def.hex}`}
                    ></span>
                  );
                })}
              </span>

              <span class="ink-row__meta">
                <span class="ink-row__badge mono">{t(CHANGEOVER_KEY[ink.data.changeover], locale)}</span>
                <span class="ink-row__heads mono">{ink.data.compat.printheads.slice(0, 2).join(' · ')}</span>
              </span>

              <span class="ink-row__cta">
                {t('explore', locale)} <span class="arrow" aria-hidden="true">›</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
        </div>
      ))}
    </section>
  </div>

  <section class="section" data-ground="bone" data-accent="magenta">
    <div class="shell grid">
      <div class="section__label"><p class="eyebrow">{tr ? 'GÜVENLİK' : 'SAFETY'}</p></div>
      <div class="section__body">
        <h2 class="reveal">
          {tr
            ? 'Güvenlik Bilgi Formları'
            : 'Safety Data Sheets'}
        </h2>
        <p class="lead reveal">
          {tr
            ? 'Güvenlik Bilgi Formu, ürünün tehlike sınıfını, depolama ve taşıma koşullarını, kişisel koruyucu donanım gereksinimini ve ilk yardım bilgilerini içerir. İthal ürünlerde form çoğunlukla yalnızca İngilizce düzenlenir; Türkçe nüsha iş sağlığı ve güvenliği mevzuatı kapsamında istenir.'
            : 'A safety data sheet states the hazard class, storage and handling conditions, required personal protective equipment and first-aid information. For imported products it is usually issued in English only; Turkish occupational safety regulation requires a Turkish copy.'}
        </p>
        <a class="link link--accent reveal" href={path('documents', locale)}>
          {tr ? 'Belgeler ve GBF' : 'Documents and safety sheets'} <span class="arrow" aria-hidden="true">›</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .ink-idx__crumbs { padding-block: var(--sp-5) var(--sp-7); }

  .ink-idx__head {
    display: grid;
    gap: var(--sp-5);
    padding-block-end: var(--sp-7);
    max-width: 78ch;
  }

  .ink-idx__head .lead { color: var(--muted); }

  .fam-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
    margin: 0 0 var(--sp-8);
    padding-block-end: var(--sp-6);
    border-bottom: var(--border) solid var(--rule);
    list-style: none;
    font-size: var(--step--1);
  }

  .fam-nav__n { font-size: var(--step--2); color: var(--muted); }

  .ink-idx__list { padding-block-end: var(--section-pad); }

  .fam + .fam { margin-block-start: var(--sp-10); }

  .fam__head {
    display: grid;
    gap: var(--sp-2);
    padding-block-end: var(--sp-5);
    border-bottom: var(--border) solid var(--ink);
  }

  @media (min-width: 1024px) {
    .fam__head {
      grid-template-columns: minmax(0, 24ch) minmax(0, 1fr) auto;
      align-items: baseline;
      gap: var(--gutter);
    }
  }

  .fam__title {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .fam__title a { color: inherit; }

  .fam__role {
    font-size: var(--step--1);
    max-width: 64ch;
  }

  .fam__count {
    font-size: var(--step--2);
    color: var(--muted);
  }

  .fam .ink-rows { border-top: 0; }

  .ink-rows {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border) solid var(--rule);
  }

  .ink-row a {
    display: grid;
    gap: var(--sp-4);
    padding-block: var(--sp-6);
    border-bottom: var(--border) solid var(--rule);
    color: inherit;
    text-decoration: none;
    transition: padding-inline-start var(--d-base) var(--e-out);
  }

  .ink-row a:hover,
  .ink-row a:focus-visible {
    padding-inline-start: var(--sp-4);
  }

  .ink-row a:hover .arrow,
  .ink-row a:focus-visible .arrow {
    transform: translateX(4px);
  }

  @media (min-width: 1024px) {
    .ink-row a {
      grid-template-columns: 30fr 22fr 26fr auto;
      align-items: center;
      gap: var(--gutter);
    }
  }

  .ink-row__main { display: grid; gap: var(--sp-2); }

  .ink-row__series {
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .ink-row__role { font-size: var(--step--1); }

  .ink-row__swatches {
    display: flex;
    gap: 3px;
  }

  .ink-row__sw {
    width: 22px;
    height: 22px;
    background: var(--swatch);
  }

  .ink-row__sw.is-outlined { box-shadow: inset 0 0 0 1px var(--hairline); }

  .ink-row__sw.is-hatched {
    background: repeating-linear-gradient(
      45deg, var(--swatch) 0 3px, color-mix(in srgb, var(--swatch) 62%, var(--ink)) 3px 6px
    );
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  .ink-row__meta { display: grid; gap: var(--sp-2); }

  .ink-row__badge {
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .ink-row__heads {
    font-size: var(--step--2);
    color: var(--muted);
  }

  .ink-row__cta {
    font-size: var(--step--1);
    font-weight: 500;
    white-space: nowrap;
  }
</style>
