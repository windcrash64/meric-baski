---
/**
 * The site's only form. One component, four locked field sets (00-SPEC §4.9).
 *
 * Three decisions are deliberate and should not be "improved":
 *
 * 1. Telephone sits BEFORE e-mail. Turkish B2B buyers hand over a mobile number
 *    far more readily than an address, and a form that asks for the address
 *    first loses the lead that would have given the number.
 * 2. There is no CAPTCHA. Spam is caught by a honeypot the user never sees;
 *    a CAPTCHA image is a tax on every real buyer to stop a bot that a hidden
 *    checkbox already stops.
 * 3. It is a plain `POST` to Web3Forms with a hidden `redirect`. With JavaScript
 *    disabled — or blocked, or broken — the form still submits and the browser
 *    still lands on the thank-you page. The script below only removes the full
 *    page reload; it is never load-bearing.
 */
import { getCollection } from 'astro:content';

import { SITE, type Locale } from '../../config/site';
import { path } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import Field from './Field.astro';

export type FormVariant = 'quote' | 'service' | 'sample' | 'general';

export interface Props {
  locale: Locale;
  variant: FormVariant;
  /** Pre-fills "İlgilendiğiniz ürün" when the form is placed on a product page. */
  product?: string;
}

const { locale, variant, product } = Astro.props;
const tr = locale === 'tr';

/* Web3Forms wants an absolute URL to redirect to, and the thank-you slug is
   per-locale — so it comes out of the route table, never a literal. */
const redirect = new URL(path('thanks', locale), SITE.url).href;
const pageUrl = new URL(Astro.url.pathname, SITE.url).href;

const SUBJECTS: Record<FormVariant, Record<Locale, string>> = {
  quote: { tr: 'Teklif talebi', en: 'Quote request' },
  service: { tr: 'Servis talebi', en: 'Service request' },
  sample: { tr: 'Numune talebi', en: 'Sample request' },
  general: { tr: 'İletişim formu', en: 'Contact form' },
};

const subject = [
  `${SITE.brand.name} web — ${SUBJECTS[variant][locale]}`,
  `[${locale.toUpperCase()}]`,
  product ? `· ${product}` : '',
].filter(Boolean).join(' ');

const wa = `https://wa.me/${SITE.contact.whatsapp.e164}?text=${
  encodeURIComponent(SITE.contact.whatsapp.prefill[locale])
}`;

/* --- select data --------------------------------------------------------- */

/** 81 il, Turkish collation. A short "major cities" list is a tell that the
    form was written by someone who has never shipped a machine to Yozgat. */
const PROVINCES = [
  'Adana', 'Adıyaman', 'Afyonkarahisar', 'Ağrı', 'Aksaray', 'Amasya', 'Ankara', 'Antalya',
  'Ardahan', 'Artvin', 'Aydın', 'Balıkesir', 'Bartın', 'Batman', 'Bayburt', 'Bilecik',
  'Bingöl', 'Bitlis', 'Bolu', 'Burdur', 'Bursa', 'Çanakkale', 'Çankırı', 'Çorum',
  'Denizli', 'Diyarbakır', 'Düzce', 'Edirne', 'Elazığ', 'Erzincan', 'Erzurum', 'Eskişehir',
  'Gaziantep', 'Giresun', 'Gümüşhane', 'Hakkâri', 'Hatay', 'Iğdır', 'Isparta', 'İstanbul',
  'İzmir', 'Kahramanmaraş', 'Karabük', 'Karaman', 'Kars', 'Kastamonu', 'Kayseri', 'Kilis',
  'Kırıkkale', 'Kırklareli', 'Kırşehir', 'Kocaeli', 'Konya', 'Kütahya', 'Malatya', 'Manisa',
  'Mardin', 'Mersin', 'Muğla', 'Muş', 'Nevşehir', 'Niğde', 'Ordu', 'Osmaniye', 'Rize',
  'Sakarya', 'Samsun', 'Siirt', 'Sinop', 'Sivas', 'Şanlıurfa', 'Şırnak', 'Tekirdağ',
  'Tokat', 'Trabzon', 'Tunceli', 'Uşak', 'Van', 'Yalova', 'Yozgat', 'Zonguldak',
];

const cityOptions = [
  ...PROVINCES.map((name) => ({ value: name, label: name })),
  { value: tr ? 'Yurt dışı' : 'Outside Türkiye', label: tr ? 'Yurt dışı' : 'Outside Türkiye' },
];

/* The service form's machine list is the catalogue itself, so a model can never
   be offered here after it has been dropped from the site. */
const machineOptions = variant === 'service'
  ? [
      ...(await getCollection('machines'))
        .sort((a, b) => a.data.order - b.data.order)
        .map((m) => ({ value: m.data.model, label: m.data.model })),
      { value: tr ? 'Listede yok' : 'Not listed', label: tr ? 'Listede yok' : 'Not listed' },
    ]
  : [];

const departmentOptions = tr
  ? [
      { value: 'Satış', label: 'Satış — makine seçimi, fiyat teklifi, demo' },
      { value: 'Teknik Servis', label: 'Teknik servis — arıza, bakım, yedek parça' },
      { value: 'Sarf sipariş', label: 'Sarf sipariş — mürekkep, film, toz' },
      { value: 'Muhasebe', label: 'Muhasebe — fatura, cari hesap' },
      { value: 'Diğer', label: t('formOther', locale) },
    ]
  : [
      { value: 'Sales', label: 'Sales — machine selection, pricing, demo' },
      { value: 'Service', label: 'Service — faults, maintenance, spare parts' },
      { value: 'Supplies', label: 'Supplies — ink, film, powder' },
      { value: 'Accounts', label: 'Accounts — invoicing, statements' },
      { value: 'Other', label: t('formOther', locale) },
    ];

/* --- KVKK consent --------------------------------------------------------
   The consent sentence is one string in ui.ts; the link is cut out of it at
   build time so the notice is named exactly once, not twice. If the sentence is
   ever reworded past recognition the whole line still renders, with the link
   appended — the checkbox is a legal requirement and may not silently break. */
const consent = t('formKvkkConsent', locale);
const consentLink = t('formKvkkLink', locale);
const cut = consent.indexOf(consentLink);
const consentBefore = cut >= 0 ? consent.slice(0, cut) : `${consent} `;
const consentAfter = cut >= 0 ? consent.slice(cut + consentLink.length) : '';
---

<form
  class="form"
  action="https://api.web3forms.com/submit"
  method="POST"
  data-contact-form
  data-redirect={redirect}
  data-sending={t('formSending', locale)}
  data-error={t('formError', locale)}
>
  <input type="hidden" name="access_key" value={SITE.forms.accessKey} />
  <input type="hidden" name="redirect" value={redirect} />
  <input type="hidden" name="subject" value={subject} />
  <input type="hidden" name="from_name" value={`${SITE.brand.name} — web`} />
  <input type="hidden" name="page" value={pageUrl} />

  <!-- Honeypot. Web3Forms discards any submission where `botcheck` is set. It is
       taken out of the layout, out of the tab order and out of the a11y tree —
       a human never meets it, and no CAPTCHA image is ever loaded. -->
  <input
    class="form__botcheck"
    type="checkbox"
    name="botcheck"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="form__grid">
    {variant === 'quote' && (
      <>
        <Field locale={locale} name="name" label={t('formName', locale)} required autocomplete="name" />
        <Field locale={locale} name="company" label={t('formCompany', locale)} autocomplete="organization" />
        <Field locale={locale} name="phone" label={t('formPhone', locale)} control="tel" required
               autocomplete="tel" inputmode="tel" />
        <Field locale={locale} name="email" label={t('formEmail', locale)} control="email"
               autocomplete="email" inputmode="email" />
        <Field locale={locale} name="city" label={t('formCity', locale)} control="select"
               options={cityOptions} autocomplete="address-level1" />
        <Field locale={locale} name="product" label={t('formProduct', locale)} value={product}
               hint={tr
                 ? 'Model adını biliyorsanız yazın; bilmiyorsanız ne bastığınızı yazmanız yeter.'
                 : 'Give the model if you know it — otherwise just tell us what you print.'} />
        <Field locale={locale} name="message" label={t('formMessage', locale)} control="textarea" span="full"
               hint={tr
                 ? 'Günlük veya aylık baskı hacminiz, bastığınız malzeme ve mevcut makineniz — teklifi doğru kurmamız için en çok işe yarayan üç bilgi.'
                 : 'Daily or monthly volume, the material you print and your current machine — the three facts that make the quote accurate.'} />
      </>
    )}

    {variant === 'service' && (
      <>
        <Field locale={locale} name="company" label={t('formCompany', locale)} required autocomplete="organization" />
        <Field locale={locale} name="name" label={t('formContactPerson', locale)} required autocomplete="name" />
        <Field locale={locale} name="phone" label={t('formPhone', locale)} control="tel" required
               autocomplete="tel" inputmode="tel" />
        <Field locale={locale} name="email" label={t('formEmail', locale)} control="email"
               autocomplete="email" inputmode="email" />
        <Field locale={locale} name="machine" label={t('formMachineModel', locale)} control="select"
               options={machineOptions} />
        <Field locale={locale} name="serial" label={t('formSerial', locale)}
               hint={tr
                 ? 'Makinenin arka panelindeki etikette yazar.'
                 : 'On the label at the back of the machine.'} />
        <Field locale={locale} name="fault" label={t('formFault', locale)} control="textarea" required span="full"
               hint={tr
                 ? 'Hata mesajı, ne zaman başladığı ve son bakım tarihi. Kafa tıkanması veya banding ise kaç geçişte ve hangi mürekkeple çalıştığınızı da yazın.'
                 : 'The error message, when it started and the date of the last service. For head clogs or banding, add the pass count and the ink you run.'} />
      </>
    )}

    {variant === 'sample' && (
      <>
        <Field locale={locale} name="name" label={t('formName', locale)} required autocomplete="name" />
        <Field locale={locale} name="company" label={t('formCompany', locale)} required autocomplete="organization" />
        <Field locale={locale} name="phone" label={t('formPhone', locale)} control="tel" required
               autocomplete="tel" inputmode="tel" />
        <Field locale={locale} name="email" label={t('formEmail', locale)} control="email"
               autocomplete="email" inputmode="email" />
        <Field locale={locale} name="address" label={t('formAddress', locale)} control="textarea" required rows={3}
               autocomplete="street-address" span="full"
               hint={tr
                 ? 'Kargonun teslim edileceği açık adres ve teslim alacak kişi.'
                 : 'The full delivery address and who will take receipt of it.'} />
        <Field locale={locale} name="interest" label={t('formInterest', locale)} value={product} />
        <Field locale={locale} name="substrate" label={t('formSubstrate', locale)}
               hint={tr
                 ? 'Numuneyi kendi malzemenize basalım: cam, ahşap, pamuklu kumaş…'
                 : 'We print the sample on your material: glass, wood, cotton…'} />
      </>
    )}

    {variant === 'general' && (
      <>
        <Field locale={locale} name="name" label={t('formName', locale)} required autocomplete="name" />
        <Field locale={locale} name="company" label={t('formCompany', locale)} autocomplete="organization" />
        <Field locale={locale} name="phone" label={t('formPhone', locale)} control="tel" required
               autocomplete="tel" inputmode="tel" />
        <Field locale={locale} name="email" label={t('formEmail', locale)} control="email"
               autocomplete="email" inputmode="email" />
        <Field locale={locale} name="department" label={t('formSubjectArea', locale)} control="select" required
               options={departmentOptions} span="full" />
        <Field locale={locale} name="message" label={t('formMessage', locale)} control="textarea" required span="full" />
      </>
    )}
  </div>

  <label class="form__consent">
    <input type="checkbox" name="kvkk" value={tr ? 'onay' : 'consent'} required />
    <span>
      {consentBefore}<a class="link link--inline" href={path('privacy', locale)}>{consentLink}</a>{consentAfter}
    </span>
  </label>

  <div class="form__foot">
    <button class="btn" type="submit">
      <span data-btn-label>{t('send', locale)}</span>
      <span class="btn__arrow" aria-hidden="true">→</span>
    </button>

    <p class="form__after">
      {t('formAfterSubmit', locale)}{' '}
      <a class="link link--inline" href={wa} target="_blank" rel="noopener">
        {t('askWhatsApp', locale)}
      </a>
    </p>
  </div>

  <p class="form__status" data-form-status role="status" hidden></p>
</form>

<style>
  .form {
    display: grid;
    gap: var(--sp-7);
  }

  .form__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6) var(--gutter);
  }

  @media (min-width: 640px) {
    .form__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .form__botcheck {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .form__consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-4);
    align-items: start;
    padding-block-start: var(--sp-2);
    font-size: var(--step--1);
    line-height: 1.5;
    max-width: 68ch;
    cursor: pointer;
  }

  .form__consent input {
    width: 20px;
    height: 20px;
    margin-block-start: 0.15em;
    accent-color: var(--ink);
    flex: none;
  }

  .form__foot {
    display: grid;
    gap: var(--sp-5);
    align-items: start;
  }

  @media (min-width: 768px) {
    .form__foot {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--sp-7);
    }
  }

  .form__foot .btn {
    justify-content: center;
  }

  .form__after {
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--on-ground-muted);
    max-width: 52ch;
  }

  /* Only ever shown by the script below, and only when the request failed. */
  .form__status {
    padding: var(--sp-4);
    border: var(--border) solid var(--danger);
    color: var(--danger);
    font-size: var(--step--1);
    max-width: none;
  }
</style>

<script>
  /**
   * Removes the full page reload — nothing else. The form is a working HTML
   * POST before this file loads and stays one if it never loads.
   *
   * The listener is delegated to `document` and registered exactly once: with
   * <ClientRouter /> the document survives navigation, so re-binding per page
   * would stack duplicate handlers and fire one request per navigation made.
   */
  const flag = '__mavenContactForm';

  if (!(window as unknown as Record<string, boolean>)[flag]) {
    (window as unknown as Record<string, boolean>)[flag] = true;

    document.addEventListener('submit', (event) => {
      const form = (event.target as HTMLElement | null)?.closest?.<HTMLFormElement>(
        'form[data-contact-form]',
      );
      if (!form || typeof fetch !== 'function') return;

      event.preventDefault();

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = form.querySelector<HTMLElement>('[data-btn-label]');
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const idle = label?.textContent ?? '';

      if (button) button.disabled = true;
      if (label && form.dataset.sending) label.textContent = form.dataset.sending;
      if (status) status.hidden = true;

      const payload = Object.fromEntries(new FormData(form).entries());

      fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      })
        .then((response) => {
          if (!response.ok) throw new Error(String(response.status));
          window.location.assign(form.dataset.redirect || form.action);
        })
        .catch(() => {
          // The enhancement failed, so it takes itself out of the way: the next
          // press is a plain browser POST, which is the path that always works.
          form.removeAttribute('data-contact-form');
          if (button) button.disabled = false;
          if (label) label.textContent = idle;
          if (status && form.dataset.error) {
            status.textContent = form.dataset.error;
            status.hidden = false;
          }
        });
    });
  }
</script>
