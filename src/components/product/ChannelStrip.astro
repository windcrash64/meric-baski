---
/**
 * The channel strip — the signature component of the ink half of the site.
 *
 * Real swatches at the brand's own process values. White gets an outline
 * because a white chip on paper is invisible, and varnish gets a hatch because
 * it has no colour at all — faking either with a grey fill would misrepresent
 * what is in the bottle.
 */
import type { Locale } from '../../config/site';
import { t } from '../../i18n/ui';
import { CHANNELS, type ChannelCode } from '../../i18n/specs';

export interface Props {
  channels: Array<{ code: string; sku: string; availability?: 'stock' | 'on-request' }>;
  locale: Locale;
  /** Show the per-channel SKU under each swatch. */
  showSku?: boolean;
}

const { channels, locale, showSku = true } = Astro.props;

const resolved = channels
  .map((ch) => ({ ...ch, def: CHANNELS[ch.code as ChannelCode] }))
  .filter((ch) => ch.def);
---

<ul class="strip" role="list" aria-label={t('channels', locale)}>
  {resolved.map((ch) => {
    const def = ch.def as { tr: string; en: string; hex: string; outlined?: boolean; hatched?: boolean };
    const onRequest = ch.availability === 'on-request';
    return (
      <li class:list={['strip__ch', { 'is-on-request': onRequest }]}>
        <span
          class:list={['strip__swatch', {
            'is-outlined': def.outlined,
            'is-hatched': def.hatched,
          }]}
          style={`--swatch:${def.hex}`}
          aria-hidden="true"
        ></span>
        <span class="strip__code mono">{ch.code}</span>
        <span class="strip__name">{def[locale]}</span>
        {showSku && <span class="strip__sku mono">{ch.sku}</span>}
        {onRequest && <span class="strip__note mono">{t('onRequest', locale)}</span>}
      </li>
    );
  })}
</ul>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 118px), 1fr));
    gap: var(--sp-5) var(--sp-4);
    margin: 0;
    padding: 0;
  }

  .strip__ch {
    display: grid;
    gap: 3px;
  }

  .strip__swatch {
    height: 56px;
    background: var(--swatch);
    margin-block-end: var(--sp-2);
  }

  /* White would otherwise vanish on paper. */
  .strip__swatch.is-outlined {
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  /* Varnish has no colour — a hatch says "clear coat", a grey fill would lie. */
  .strip__swatch.is-hatched {
    background: repeating-linear-gradient(
      45deg,
      var(--swatch) 0 5px,
      color-mix(in srgb, var(--swatch) 62%, var(--on-ground)) 5px 10px
    );
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  .strip__code {
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .strip__name {
    font-size: var(--step--2);
    color: var(--on-ground-muted);
    line-height: 1.3;
  }

  .strip__sku {
    font-size: var(--step--2);
    color: color-mix(in srgb, var(--on-ground-muted) 72%, transparent);
  }

  .strip__note {
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .is-on-request .strip__swatch {
    opacity: 0.45;
  }
</style>
