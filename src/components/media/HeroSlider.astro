---
/**
 * Homepage hero.
 *
 * Image and type, nothing else. The previous version carried a bordered arrow
 * box on each side, a boxed counter and a bordered pause button — four pieces
 * of furniture competing with the one picture the section exists to show. What
 * is left is the machine, the words, and a hairline meter that is at once the
 * timer, the position indicator and the slide picker.
 *
 * That meter is also the WCAG 2.2.2 answer: the hero autoplays, so a visible
 * way to stop it is not optional. Making the control and the indicator the same
 * object keeps the number of visible controls at one.
 *
 * The section is exactly one screen tall and splits into an image row and a
 * copy row. On a phone the image row is capped as a fraction of the viewport so
 * the machine stays a contained, centred object rather than a backdrop the type
 * has to fight; on a wide screen the machine moves right and the type takes the
 * empty left of the field.
 *
 * The page's <h1> is rendered ONCE, outside the slides — four slides each
 * carrying an <h1> would give the document four of them.
 */
import type { Locale } from '../../config/site';
import { t } from '../../i18n/ui';
import Picture from './Picture.astro';

export interface HeroSlide {
  image: string;
  eyebrow: string;
  model: string;
  body: string;
  href: string;
  alt: string;
}

export interface Props {
  slides: HeroSlide[];
  locale: Locale;
  heading: string;
  intro: string;
}

const { slides, locale, heading } = Astro.props;
const tr = locale === 'tr';
---

<section
  class="hero"
  data-ground="panel"
  data-accent="cyan"
  data-hero
  data-hero-paused="false"
  aria-labelledby="hero-title"
>
  <div class="hero__media">
    {slides.map((slide, i) => (
      <div class="hero__frame" data-hero-frame data-active={i === 0 ? 'true' : 'false'}>
        <Picture
          src={slide.image}
          alt={slide.alt}
          ratio="none"
          graded={false}
          priority={i === 0}
          sizes="(min-width: 900px) 62vw, 92vw"
        />
      </div>
    ))}
  </div>

  <div class="shell hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__h1">{heading}</h1>

      <div class="hero__slides">
        {slides.map((slide, i) => (
          <article
            class="hero__slide"
            data-hero-slide
            data-active={i === 0 ? 'true' : 'false'}
            aria-hidden={i === 0 ? undefined : 'true'}
            inert={i === 0 ? undefined : ''}
          >
            <p class="eyebrow hero__eyebrow">{slide.eyebrow}</p>
            <h2 class="hero__model model" lang="en">
              {slide.model.split(' ').map((w, n) => <>{n > 0 ? ' ' : ''}<span>{w}</span></>)}
            </h2>
            <p class="hero__body">{slide.body}</p>
            <a class="link link--accent hero__cta" href={slide.href}>
              {tr ? 'Ürünü İncele' : 'View product'}
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>

      <!-- One control. Each bar is a slide, the active bar fills across the
           interval, and pressing any bar both jumps to it and stops the
           rotation — so the pause mechanism IS the indicator. -->
      <div class="hero__meter" role="tablist" aria-label={t('carousel', locale)}>
        {slides.map((slide) => (
          <button type="button" role="tab" data-hero-dot aria-selected="false">
            <span class="visually-hidden">{slide.model}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Arrows and pause exist for keyboard and assistive tech; they are not part
       of the picture, and they surface only when focused. -->
  <button type="button" class="hero__kbd" data-hero-prev>
    <span>{t('previous', locale)}</span>
  </button>
  <button type="button" class="hero__kbd" data-hero-next>
    <span>{t('next', locale)}</span>
  </button>
  <button type="button" class="hero__kbd" data-hero-pause aria-pressed="false">
    <span data-hero-pause-label>{t('pause', locale)}</span>
    <span class="visually-hidden" data-hero-pause-icon></span>
  </button>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    /* Image and copy are one centred block, not a row pinned to the top and a
       row pinned to the bottom — that left a hole down the middle of the phone
       screen wide enough to read as a mistake. */
    grid-template-rows: auto auto;
    align-content: center;
    overflow: hidden;
    /* Definite height so the section is exactly one screen. svh is the viewport
       with the browser chrome showing, which is the state a phone paints in;
       vh would hand back ~150 px that are not on screen. */
    height: calc(100vh - var(--header-h));
    height: calc(100svh - var(--header-h));
    min-height: 400px;
  }

  /* --- image ---------------------------------------------------------------- */
  .hero__media {
    grid-row: 1;
    display: grid;
    min-height: 0;
    /* Capped as a fraction of the screen so the machine reads as a contained
       object, centred, rather than a backdrop the type has to fight. */
    height: auto;
    max-height: 34svh;
    align-self: center;
    justify-self: center;
    width: 100%;
    /* Runs to the screen edges on a phone: inset by the page margin, the
       render's own studio floor ends in a visible rectangle a few shades off
       the ground it sits on. At the viewport edge there is nothing to compare
       it against, and the machine gets the extra width. */
    max-width: 560px;
  }

  /* One stage, every slide — matching the canvas Blender composes on, so the
     machine keeps its size and position through a rotation and `contain` has
     nothing to letterbox. (The image pipeline deliberately does not trim the
     cutouts; see tools/build-images.mjs.) */
  .hero__frame {
    grid-area: 1 / 1;
    aspect-ratio: 16 / 10;
    min-height: 0;
    opacity: 0;
    transform: scale(1.015);
    transition: opacity 700ms var(--e-out), transform 900ms var(--e-out);
  }

  .hero__frame[data-active='true'] {
    opacity: 1;
    transform: none;
  }

  /* <picture> is inline by default, which leaves a text-baseline gap under the
     image and — worse — gives the <img> an auto-height containing block, so any
     percentage height on the image silently resolves to auto. */
  .hero__frame :global(picture) {
    display: block;
  }

  .hero__frame :global(picture),
  .hero__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
  }

  /* --- type ----------------------------------------------------------------- */
  .hero__inner {
    grid-row: 2;
    display: grid;
    align-content: start;
    padding-block: var(--sp-5) 0;
  }

  .hero__copy {
    display: grid;
    gap: var(--sp-3);
    max-width: 46ch;
  }

  .hero__h1 {
    font-size: var(--step--1);
    font-weight: 500;
    font-variation-settings: 'wdth' 100;
    letter-spacing: 0.01em;
    line-height: 1.4;
    color: var(--muted);
    max-width: 36ch;
  }

  .hero__slides {
    display: grid;
  }

  .hero__slide {
    grid-area: 1 / 1;
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    justify-items: start;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity var(--d-slow) var(--e-out), transform var(--d-slow) var(--e-out);
    pointer-events: none;
  }

  .hero__slide[data-active='true'] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .hero__eyebrow {
    color: var(--accent-text);
  }

  .hero__model {
    font-size: var(--step-2);
    font-weight: 600;
    font-variation-settings: 'wdth' 84;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .hero__body {
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 44ch;
  }

  .hero__cta {
    font-size: var(--step-0);
    font-weight: 500;
    margin-block-start: var(--sp-1);
  }

  /* --- the one control ------------------------------------------------------- */
  .hero__meter {
    display: flex;
    gap: var(--sp-2);
    margin-block-start: var(--sp-3);
  }

  .hero__meter button {
    position: relative;
    width: clamp(32px, 9vw, 56px);
    height: 2px;
    background: color-mix(in srgb, var(--ink) 20%, transparent);
    overflow: hidden;
  }

  /* 2 px mark, 44 px target. */
  .hero__meter button::before {
    content: '';
    position: absolute;
    inset: -21px 0;
  }

  .hero__meter button::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .hero__meter button[aria-selected='true']::after {
    animation: hero-meter 6500ms linear forwards;
  }

  /* Paused: the bar shows position rather than progress. */
  [data-hero-paused='true'] .hero__meter button[aria-selected='true']::after {
    animation: none;
    transform: scaleX(1);
  }

  @keyframes hero-meter {
    to {
      transform: scaleX(1);
    }
  }

  .hero__kbd {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    inset-block-start: 0;
    inset-inline-start: 0;
  }

  .hero__kbd:focus-visible {
    width: auto;
    height: auto;
    clip-path: none;
    inset: auto auto var(--sp-5) var(--sp-5);
    padding: var(--sp-3) var(--sp-4);
    background: var(--ink);
    color: var(--paper);
    font-size: var(--step--2);
    z-index: 3;
  }

  /* --- wide: the machine moves right, the type takes the empty left ---------- */
  @media (min-width: 900px) {
    .hero {
      grid-template-rows: 1fr;
      min-height: 520px;
    }

    .hero__media {
      grid-row: 1;
      grid-column: 1;
      /* Width-driven and centred against the type. The renders fill their
         canvas — on DTF the machine itself reaches the last row of pixels — so
         the floor would be cut off square at the frame; the image pipeline
         fades it out instead, and only where it is already semi-transparent, so
         the machine passes through untouched and the box can float. */
      height: auto;
      max-height: 68svh;
      max-width: none;
      align-self: center;
      /* Left edge clears the 40ch copy column; right edge runs to the bleed. */
      padding: 0 0 0 40%;
    }

    .hero__inner {
      grid-row: 1;
      grid-column: 1;
      align-content: center;
      padding-block: var(--sp-8);
    }

    .hero__copy {
      max-width: 40ch;
    }

    .hero__model {
      font-size: var(--step-4);
    }

    .hero__body {
      font-size: var(--step-0);
    }

    .hero__h1 {
      font-size: var(--step-0);
    }
  }

  /* Landscape phones: the copy alone fills the screen, so the image steps back. */
  @media (max-height: 620px) and (max-width: 899px) {
    /* The 400 px floor is there so the hero cannot collapse; on a landscape
       phone it is taller than the screen, which is the one case it makes worse. */
    .hero {
      min-height: 0;
    }

    .hero__media {
      max-height: 26svh;
    }

    .hero__h1 {
      display: none;
    }

    .hero__body {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__frame,
    .hero__slide {
      transition: opacity 200ms linear;
      transform: none;
    }

    .hero__meter button[aria-selected='true']::after {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>
