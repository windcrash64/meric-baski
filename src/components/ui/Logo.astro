---
/**
 * The Maven mark, inlined.
 *
 * Inlined on purpose: `currentColor` only inherits when the SVG is in the DOM.
 * Referenced through <img> or <object> it resolves against the SVG's own
 * document and the wordmark renders black on the ink footer.
 *
 * Geometry is generated by tools/build_brand.py from the module grid the mark
 * was designed on — do not hand-edit the path.
 */
export interface Props {
  /** Height in px; the mark is 7.84375 : 3, so width follows. */
  height?: number;
  /** Drop the CMYK cluster — for tight lockups and one-colour contexts. */
  wordmarkOnly?: boolean;
  class?: string;
  title?: string;
}

const { height = 28, wordmarkOnly = false, class: className = '', title = 'Maven' } = Astro.props;

const MARK =
  'M0 0L1.4375 0L2.4219 1.7227L3.4063 0L4.8438 0L4.8438 1L3.9598 1L2.817 3L2.0268 3' +
  'L1 1.2031L1 3L0 3ZM3.8438 2L4.8438 2L4.8438 3L3.8438 3Z';

const vbWidth = wordmarkOnly ? 4.84375 : 7.84375;
---

<svg
  class={className}
  viewBox={`0 0 ${vbWidth} 3`}
  height={height}
  width={(height * vbWidth) / 3}
  role="img"
  aria-label={title}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <title>{title}</title>
  <path fill="currentColor" d={MARK} />
  {!wordmarkOnly && (
    <>
      <rect fill="#0081D2" x="5.8438" y="0" width="1" height="1" />
      <rect fill="#E30161" x="6.8438" y="1" width="1" height="1" />
      <rect fill="#FFE305" x="5.8438" y="2" width="1" height="1" />
    </>
  )}
</svg>
